{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/router"
    }
  ],
  "functions": {
    "api/router.mjs": {
      "includeFiles": "deployment-data/**",
      "maxDuration": 60
    }
  }
}
