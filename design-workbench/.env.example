# 工作台默认使用可重复的本地演示数据。
VITE_DEMO_MODE=true
VITE_API_BASE_URL=
VITE_LEARNING_URL=/learning/

# 临时测试站点账号，仅由工作台 API 读取。
WQT_TEST_DB=./data/test-wqt.db

# 可选：从只读的服务端环境文件加载短信、复盘和对象存储配置。
# 默认寻找同级生产仓库的 .env；也可以改为专用测试服务环境文件。
WQT_SERVICE_ENV=
BMOB_APP_ID=
BMOB_REST_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# 卡牌语音仅由服务端调用火山引擎，密钥禁止使用 VITE_ 前缀或传给浏览器。
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_VOICE_TYPE=zh_female_xueayi_saturn_bigtts
VOLCENGINE_TTS_VOICE_NAME=小伍·儿童绘本
VOLCENGINE_TTS_SPEED_RATIO=1.0
VOLCENGINE_TTS_LOUDNESS_RATIO=1.0

# 正式接入时改为：
# VITE_DEMO_MODE=false
# VITE_API_BASE_URL=https://your-domain.example.com
