{
  "name": "wqt-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "npm --prefix enterprise-panel install && npm --prefix enterprise-panel run build && npm --prefix admin-web install && npm --prefix admin-web run build",
    "migrate:pg": "node scripts/migrate_sqlite_to_pg.mjs",
    "test:bench": "node test/bench/run.mjs",
    "change:new": "node scripts/artifacts/new-change.mjs",
    "check:artifacts": "node scripts/artifacts/check.mjs",
    "test:artifacts": "node --test tests/artifacts.test.mjs",
    "test:runtime": "node --test tests/runtime/*.test.mjs"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "pg": "^8.21.0",
    "sqlite3": "^5.1.7"
  }
}
