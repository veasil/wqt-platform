# 本地开发示例：仅连接你自己的隔离开发库，不可直接用于生产部署。
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://<user>:<password>@127.0.0.1:5432/<development_database>
CARDS_SOURCE=postgres
# 不配置 CARDS_DATABASE_URL 时卡牌复用主库。
SETTINGS_ENCRYPTION_KEY=<replace_with_64_hex_characters>
# 保持运行代码的默认 legacy 语义；新版 /player/ 接入显式改为 accounts。
WQT_ACCOUNT_MODEL=legacy
# accounts 模式必需：专用开发 Redis 与独立命名空间。
REDIS_URL=redis://127.0.0.1:6379
WQT_REDIS_NAMESPACE=wqt:local:replace_with_your_name

# JWT 签名密钥（务必改成随机长字符串）
JWT_SECRET=change_me_to_a_long_random_secret

# 主库使用 PostgreSQL；DB_PATH 不是主库隔离配置。

# （可选）LLM：把你的 Key 放这里，前端不会暴露
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-reasoner

# （可选）生图调用方：toapis / dashscope
IMAGE_PROVIDER=toapis
TOAPIS_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TOAPIS_BASE_URL=https://toapis.com
TOAPIS_IMAGE_MODEL=gpt-image-2
TOAPIS_IMAGE_QUALITY=medium
TOAPIS_IMAGE_RESOLUTION=1k

# Bmob短信服务配置
BMOB_APP_ID=your_bmob_app_id
BMOB_REST_KEY=your_bmob_rest_key

# （可选）微信登录（不同场景对应不同 AppID/Secret）
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_REDIRECT_URI=

# Report and option feedback share these defaults (database settings still win).
DEFAULT_LLM_PROVIDER=DeepSeek
DEFAULT_LLM_MODEL=deepseek-reasoner

# Captcha: deployment environment only. Unset provider keeps the existing Tencent integration.
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=tencent
CAPTCHA_APP_ID=
CAPTCHA_APP_SECRET_KEY=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# Alibaba Cloud Captcha 2.0 V3, pay-as-you-go. Use a dedicated RAM credential, not OSS keys.
# Current deployment choice: cn (Shanghai). sgp requires a matching Singapore instance.
ALIYUN_CAPTCHA_REGION=cn
ALIYUN_CAPTCHA_PREFIX=
ALIYUN_CAPTCHA_SCENE_ID=
ALIYUN_CAPTCHA_ACCESS_KEY_ID=
ALIYUN_CAPTCHA_ACCESS_KEY_SECRET=

# New player card narration: Volcengine Speech credentials (separate from Ark).
VOLC_TTS_API_KEY=
# Legacy Speech console may instead use APP_ID + ACCESS_KEY.
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_KEY=
VOLC_TTS_SPEAKER=zh_male_shaonianzixin_moon_bigtts
VOLC_TTS_RESOURCE_ID=seed-tts-1.0
VOLC_TTS_SPEECH_RATE=-5
