# 端口
PORT=8080

# JWT 签名密钥（务必改成随机长字符串）
JWT_SECRET=change_me_to_a_long_random_secret

# SQLite 数据库文件路径
DB_PATH=./data/app.sqlite

# （可选）LLM：把你的 Key 放这里，前端不会暴露
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-reasoner

# （可选）生图调用方：toapis / dashscope
IMAGE_PROVIDER=toapis
TOAPIS_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TOAPIS_BASE_URL=https://toapis.com
TOAPIS_IMAGE_MODEL=gpt-image-2
TOAPIS_IMAGE_QUALITY=medium
TOAPIS_IMAGE_RESOLUTION=1k

# Bmob短信服务配置
BMOB_APP_ID=your_bmob_app_id
BMOB_REST_KEY=your_bmob_rest_key

# （可选）微信登录（不同场景对应不同 AppID/Secret）
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_REDIRECT_URI=

# Report and option feedback share these defaults (database settings still win).
DEFAULT_LLM_PROVIDER=DeepSeek
DEFAULT_LLM_MODEL=deepseek-reasoner

# Captcha: deployment environment only. Unset provider keeps the existing Tencent integration.
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=tencent
CAPTCHA_APP_ID=
CAPTCHA_APP_SECRET_KEY=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# Alibaba Cloud Captcha 2.0 V3, pay-as-you-go. Use a dedicated RAM credential, not OSS keys.
# Current deployment choice: cn (Shanghai). sgp requires a matching Singapore instance.
ALIYUN_CAPTCHA_REGION=cn
ALIYUN_CAPTCHA_PREFIX=
ALIYUN_CAPTCHA_SCENE_ID=
ALIYUN_CAPTCHA_ACCESS_KEY_ID=
ALIYUN_CAPTCHA_ACCESS_KEY_SECRET=
